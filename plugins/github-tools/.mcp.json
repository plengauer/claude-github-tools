{
  "mcpServers": {
    "GitHub": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "X-MCP-Toolsets": "all",
        "X-MCP-Insiders": "true"
      },
      "headersHelper": "node ${CLAUDE_PLUGIN_ROOT}/scripts/github-headers.js"
    },
    "GitHub REST API": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/docker-or-stub.js",
        "ghcr.io/plengauer/mcp-github-rest:latest"
      ],
      "env": {
        "API_MCP_MODE": "stdio",
        "HTTP_AUTHORIZATION": "Bearer ${user_config.github_token}"
      }
    },
    "GitHub GraphQL API": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/docker-or-stub.js",
        "ghcr.io/plengauer/mcp-github-graphql:latest"
      ],
      "env": {
        "API_MCP_MODE": "stdio",
        "HTTP_AUTHORIZATION": "Bearer ${user_config.github_token}"
      }
    }
  }
}
